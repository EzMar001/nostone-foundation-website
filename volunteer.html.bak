<!DOCTYPE html>
<!-- ============================================
     No Stone Foundation - Volunteer Enquiry
     File: volunteer.html
     Description: Form page for prospective volunteers
     to submit their details and areas of interest.
     ============================================ -->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Volunteer with No Stone Foundation. Fill out our enquiry form to get involved.">
    <title>Volunteer | No Stone Foundation</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>

    <!-- ============================================
         HEADER & NAVIGATION
         ============================================ -->
    <header class="site-header">
        <div class="container">
            <a href="index.html" class="logo">No Stone Foundation</a>
            <button class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">☰</button>
            <nav class="main-nav" aria-label="Main navigation">
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li><a href="about.html">About Us</a></li>
                    <li><a href="programmes.html">Programmes</a></li>
                    <li><a href="volunteer.html" class="active">Volunteer</a></li>
                    <li><a href="contact.html">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- ============================================
         MAIN CONTENT
         ============================================ -->
    <main>

        <!-- Page Introduction -->
        <section class="content-section bg-cream" aria-label="Volunteer introduction">
            <div class="container">
                <h1 class="page-title">Get Involved</h1>
                <p style="text-align: center; max-width: 700px; margin: 0 auto 2rem;">Our volunteers are the backbone of everything we do. Whether you can spare an hour a week or commit to a full programme, your contribution makes a real difference.</p>
            </div>
        </section>

        <!-- Volunteer Enquiry Form -->
        <section class="content-section bg-white" aria-label="Volunteer enquiry form">
            <div class="container">
                <h2 class="section-heading">Volunteer Enquiry Form</h2>
                <p style="text-align: center; margin-bottom: 2rem;">Fill in the form below and our team will get back to you within 3 business days.</p>

                <!-- 
                     Form uses HTML5 validation attributes:
                     - required: ensures field cannot be left empty
                     - type="email": validates email format
                     - type="tel": expects telephone format
                -->
                <form class="form-container" action="#" method="POST" novalidate>

                    <!-- Full Name Field -->
                    <div class="form-group">
                        <label for="fullName" class="required">Full Name</label>
                        <input type="text" id="fullName" name="fullName" required 
                               placeholder="Enter your full name"
                               aria-required="true">
                    </div>

                    <!-- Email Field -->
                    <div class="form-group">
                        <label for="email" class="required">Email Address</label>
                        <input type="email" id="email" name="email" required 
                               placeholder="your.email@example.com"
                               aria-required="true">
                    </div>

                    <!-- Phone Field -->
                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" 
                               placeholder="011 123 4567">
                    </div>

                    <!-- Area of Interest Dropdown -->
                    <div class="form-group">
                        <label for="interest" class="required">Area of Interest</label>
                        <select id="interest" name="interest" required aria-required="true">
                            <option value="" disabled selected>Select an area...</option>
                            <option value="tutoring">After-School Tutoring</option>
                           
                            <option value="mentorship">Youth Mentorship</option>
                            <option value="digital">Digital Literacy</option>
                            <option value="sports">Sports & Recreation</option>
                            <option value="arts">Arts & Culture</option>
                            <option value="events">Event Support</option>
                            <option value="admin">Administration</option>
                        </select>
                    </div>

                    <!-- Availability -->
                    <div class="form-group">
                        <label for="availability" class="required">Availability</label>
                        <select id="availability" name="availability" required aria-required="true">
                            <option value="" disabled selected>Select availability...</option>
                            <option value="weekdays">Weekdays</option>
                            <option value="weekends">Weekends</option>
                            <option value="evenings">Evenings Only</option>
                            <option value="flexible">Flexible</option>
                        </select>
                    </div>

                    <!-- Message Field -->
                    <div class="form-group">
                        <label for="message">Why do you want to volunteer?</label>
                        <textarea id="message" name="message" 
                                  placeholder="Tell us a bit about yourself and why you'd like to volunteer..."
                                  rows="5"></textarea>
                    </div>

                    <!-- Submit Button -->
                    <div style="text-align: center;">
                        <button type="submit" class="submit-btn">Submit Enquiry</button>
                    </div>

                    <!-- Required field note -->
                    <p class="form-note">* All fields marked with an asterisk are required.</p>
                </form>
            </div>
        </section>

        <!-- Volunteer Benefits -->
        <section class="content-section bg-cream" aria-label="Why volunteer">
            <div class="container">
                <h2 class="section-heading">Why Volunteer With Us?</h2>
                <div class="two-column">
                    <div>
                        <h3 class="subsection-heading">For You</h3>
                        <ul>
                            <li>Gain valuable experience in youth development</li>
                            <li>Build your professional network</li>
                            
                            <li>Access to free training workshops</li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="subsection-heading">For the Community</h3>
                        <ul>
                            <li>Directly impact young people's lives</li>
                            <li>Help reduce youth unemployment</li>
                            <li>Strengthen community bonds</li>
                            <li>Create positive role models</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- ============================================
         FOOTER
         ============================================ -->
    <footer class="site-footer">
        <div class="container">
            <p><strong>No Stone Foundation</strong></p>
            <p>Skool Street, Kalbaskral,7300</p>
            <p>Email: <a href="mark@no-stone.org">mark@no-stone.org</a> | Phone: Phone: Phone: +27 67 713 0698</p>
            <div class="social-links">
                <a href="#" aria-label="Facebook">Facebook</a> |
                <a href="#" aria-label="Twitter">Twitter</a> |
                <a href="#" aria-label="Instagram">Instagram</a>
            </div>
            <p style="margin-top: 1rem; font-size: 0.9rem;">&copy; 2026 No Stone Foundation. All rights reserved.</p>
        </div>
    </footer>

    <script src="js/script.js"></script>
</body>
</html>
