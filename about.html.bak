<!DOCTYPE html>
<!-- ============================================
     No Stone Foundation - About Us
     File: about.html
     Description: Organisation history, mission,
     vision, and team information.
     ============================================ -->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Learn about No Stone Foundation's mission, vision, and history.">
    <title>About Us | No Stone Foundation</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>

    <!-- ============================================
         HEADER & NAVIGATION
         Identical structure across all pages.
         ============================================ -->
    <header class="site-header">
        <div class="container">
            <a href="index.html" class="logo">No Stone Foundation</a>
            <button class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">☰</button>
            <nav class="main-nav" aria-label="Main navigation">
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li><a href="about.html" class="active">About Us</a></li>
                    <li><a href="programmes.html">Programmes</a></li>
                    <li><a href="volunteer.html">Volunteer</a></li>
                    <li><a href="contact.html">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- ============================================
         MAIN CONTENT
         ============================================ -->
    <main>

        <!-- Page Title Section -->
        <section class="content-section bg-cream" aria-label="About us introduction">
            <div class="container">
                <h1 class="page-title">About Us</h1>
                <p style="text-align: center; max-width: 700px; margin: 0 auto 2rem;">Founded in 2022, No Stone Foundation was built on a simple belief: no young person should be left behind.</p>
            </div>
        </section>

        <!-- Mission & Vision Section (Two-Column Layout) -->
        <section class="content-section bg-white" aria-label="Mission and vision">
            <div class="container">
                <div class="two-column">
                    <!-- Left Column: Narrative Text -->
                    <div>
                        <h2 class="section-heading">Our Story</h2>
                        <p>No Stone is a group of professional people that all have a history of teaching, coaching and mentoring. This is one of the core tenets of the organisation</p>
                        

                        <h3 class="subsection-heading">Our Mission</h3>
                        <p>To provide accessible learning resources and safe community spaces that enable young people to build sustainable futures.</p>

                        <h3 class="subsection-heading">Our Vision</h3>
                        <p>A society where every youth, regardless of background, has the tools to thrive and contribute meaningfully to their community.</p>
                    </div>

                    <!-- Right Column: Stats & Impact -->
                    <div>
                        <h2 class="section-heading">Our Impact</h2>
                        <div class="programme-card" style="margin-bottom: 1.5rem;">
                            <div class="programme-card-content">
                                
                                <p>Since our founding, we have supported many young people through our various programmes.</p>
                            </div>
                        </div>
                        <div class="programme-card" style="margin-bottom: 1.5rem;">
                            <div class="programme-card-content">
                                <h3> 6 Active Programmes</h3>
                                <p>From sports to academics, we run 6 + programmes tailored to community needs.</p>
                            </div>
                        </div>
                        <div class="programme-card">
                            <div class="programme-card-content">
                                <h3> Volunteers</h3>
                                <p>Our dedicated team of volunteers includes teachers and professionals.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Team Section -->
        <section class="content-section bg-cream" aria-label="Our team">
            <div class="container">
                <h2 class="section-heading">Meet the Team</h2>
                <div class="programme-grid">
                    <div class="programme-card">
                        <!-- Placeholder image for team member -->
                        <img src="images/team1.jpg" alt="Portrait of Director">
                        <div class="programme-card-content">
                            <h3>Heike</h3>
                            <p><strong>Director</strong></p>
                            <p>With 24 years of outreach ministry experience</p>
                        </div>
                    </div>
                    <div class="programme-card">
                        <img src="images/team2.jpg" alt="Sports Coordinator">
                        <div class="programme-card-content">
                            <h3>Mark</h3>
                            <p><strong>Sports Coordinator</strong></p>
                            <p>Manages our sports programmes , with 40 years of experience</p>
                        </div>
                    </div>
                    <div class="programme-card">
                        <img src="images/team3.jpg" alt=" Community Outreach Manager">
                        <div class="programme-card-content">
                            <h3>Jo-Anne </h3>
                            <p><strong>Community Outreach</strong></p>
                            <p>Builds partnerships with schools, and has over 30 years of ministry and outreach</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- ============================================
         FOOTER
         ============================================ -->
    <footer class="site-footer">
        <div class="container">
            <p><strong>No Stone Foundation</strong></p>
            <p>Skool Street, Kalbaskraal</p>
            <p>Email: <a href="mailto:mark@no-stone.org">mark@no-stone.org</a> | Phone: 011 123 4567</p>
            <div class="social-links">
                <a href="#" aria-label="Facebook">Facebook</a> |
                <a href="#" aria-label="Twitter">Twitter</a> |
                <a href="#" aria-label="Instagram">Instagram</a>
            </div>
            <p style="margin-top: 1rem; font-size: 0.9rem;">&copy; 2026 No Stone Foundation. All rights reserved.</p>
        </div>
    </footer>

    <script src="js/script.js"></script>
</body>
</html>
